{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "cities-route": {
        "ClusterId": "cities-cluster",
        "Match": {
          "Path": "/api/cities/{**catch-all}"
        }
      },
      "auth-route": {
        "ClusterId": "cities-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "weather-route": {
        "ClusterId": "weather-cluster",
        "Match": {
          "Path": "/api/weather/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "cities-cluster": {
        "Destinations": {
          "cities": {
            "Address": "http://localhost:5249/"
          }
        }
      },
      "weather-cluster": {
        "Destinations": {
          "weather": {
            "Address": "http://localhost:5250/"
          }
        }
      }
    }
  }
}
