{
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cache": {
    "Duration": 10
  },
  "ConnectionStrings": {
    "Default": "Data Source=interview.db"
  },
  "WeatherApi": {
    "BaseUrl": "https://api.open-meteo.com/"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5249",
        "Protocols": "Http1AndHttp2"
      },
      "Grpc": {
        "Url": "http://localhost:5248",
        "Protocols": "Http2"
      }
    }
  }
}
