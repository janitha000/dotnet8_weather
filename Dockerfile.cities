# Cities API (InterviewApi) — build from repo root:
#   docker build -f Dockerfile.cities -t cities-api:local .

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY InterviewApi.csproj ./
COPY Protos/ ./Protos/
RUN dotnet restore InterviewApi.csproj

COPY . ./
RUN dotnet publish InterviewApi.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 8080
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "InterviewApi.dll"]
