# Cities API — build from repo root:
#   docker build -f Dockerfile.cities -t cities-api:local .

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY src/Cities.Api/Cities.Api.csproj src/Cities.Api/
COPY src/Contracts/ src/Contracts/
RUN dotnet restore src/Cities.Api/Cities.Api.csproj

COPY src/Cities.Api/ src/Cities.Api/
COPY src/Contracts/ src/Contracts/
RUN dotnet publish src/Cities.Api/Cities.Api.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 8080
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "Cities.Api.dll"]
